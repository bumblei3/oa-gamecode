diff a/code/game/g_client.c b/code/game/g_client.c	(rejected hunks)
@@ -1191,9 +1191,31 @@ void ClientUserinfoChanged( int clientNum ) {
 		if ( client->pers.maxHealth < 1 || client->pers.maxHealth > 100 ) {
 			client->pers.maxHealth = 100;
 		}
+#ifdef NEONARENA_MOD
+		// NeonWave boss drones: 4x health
+		if ( atoi( Info_ValueForKey( userinfo, "neonwave_boss" ) ) == 1 ) {
+			char hcBuf[8];
+			trap_Cvar_VariableStringBuffer( "g_neonwave_bosshc", hcBuf, sizeof(hcBuf) );
+			client->pers.maxHealth = atoi( hcBuf );
+			if ( client->pers.maxHealth < 400 ) {
+				client->pers.maxHealth = 400;
+			}
+			client->pers.neonwaveBoss = qtrue;
+			if ( client->pers.maxHealth >= 600 ) {
+				client->pers.nwBossTank = qtrue;
+			}
+		}
+		// NeonWave player upgrades: +25 max HP per level (cap +150)
+		else if ( g_gametype.integer == GT_NEONWAVE
+				&& !( ent->r.svFlags & SVF_BOT )
+				&& client->pers.neonwaveUpHp > 0 ) {
+			int bonus = client->pers.neonwaveUpHp * 25;
+			if ( bonus > 150 ) bonus = 150;
+			client->pers.maxHealth = 100 + bonus;
+		}
+#endif
 	}
 	client->ps.stats[STAT_MAX_HEALTH] = client->pers.maxHealth;
-
 	// set model
 	if( g_gametype.integer >= GT_TEAM && g_ffa_gt==0) {
 		Q_strncpyz( model, Info_ValueForKey (userinfo, "team_model"), sizeof( model ) );
@@ -1811,6 +1833,14 @@ void ClientSpawn(gentity_t *ent) {
 
 	if(g_gametype.integer != GT_ELIMINATION && g_gametype.integer != GT_CTF_ELIMINATION && g_gametype.integer != GT_LMS && !g_elimination_allgametypes.integer)
 	{
+#ifdef NEONARENA_MOD
+		// NeonWave: railgun + lightning only (neon identity)
+		client->ps.stats[STAT_WEAPONS] = ( 1 << WP_RAILGUN ) | ( 1 << WP_LIGHTNING ) | ( 1 << WP_GAUNTLET );
+		client->ps.ammo[WP_RAILGUN] = 20;
+		client->ps.ammo[WP_LIGHTNING] = 150;
+		client->ps.ammo[WP_GAUNTLET] = -1;
+		client->ps.ammo[WP_GRAPPLING_HOOK] = -1;
+#else
 		client->ps.stats[STAT_WEAPONS] = ( 1 << WP_MACHINEGUN );
 		if ( g_gametype.integer == GT_TEAM ) {
 			client->ps.ammo[WP_MACHINEGUN] = 50;
@@ -1821,6 +1851,7 @@ void ClientSpawn(gentity_t *ent) {
 		client->ps.stats[STAT_WEAPONS] |= ( 1 << WP_GAUNTLET );
 		client->ps.ammo[WP_GAUNTLET] = -1;
 		client->ps.ammo[WP_GRAPPLING_HOOK] = -1;
+#endif
 
 		// health will count down towards max_health
 		ent->health = client->ps.stats[STAT_HEALTH] = client->ps.stats[STAT_MAX_HEALTH] + 25;
@@ -1901,6 +1932,28 @@ void ClientSpawn(gentity_t *ent) {
 	G_SetOrigin( ent, spawn_origin );
 	VectorCopy( spawn_origin, client->ps.origin );
 
+#ifdef NEONARENA_MOD
+	// NeonWave: cyan dlight on drones, stronger magenta on the boss
+	if ( g_gametype.integer == GT_NEONWAVE ) {
+		if ( ent->client->pers.neonwaveBoss ) {
+			char btBuf[8];
+			int bossType;
+			trap_Cvar_VariableStringBuffer( "g_neonwave_bosstype_eff", btBuf, sizeof(btBuf) );
+			bossType = atoi( btBuf );
+			ent->s.constantLight = 255 | ( 0 << 8 ) | ( 255 << 16 ) | ( 120 << 24 );
+			if ( bossType == 2 ) {
+				ent->client->ps.stats[STAT_WEAPONS] |= ( 1 << WP_MACHINEGUN );
+				ent->client->ps.ammo[WP_MACHINEGUN] = 999;
+			} else {
+				ent->client->ps.stats[STAT_WEAPONS] |= ( 1 << WP_RAILGUN );
+				ent->client->ps.ammo[WP_RAILGUN] = 999;
+			}
+		} else if ( ent->r.svFlags & SVF_BOT ) {
+			ent->s.constantLight = 0 | ( 180 << 8 ) | ( 255 << 16 ) | ( 28 << 24 );
+		}
+	}
+#endif
+
 	// the respawned flag will be cleared after the attack and jump keys come up
 	client->ps.pm_flags |= PMF_RESPAWNED;
 	if(g_gametype.integer==GT_ELIMINATION || g_gametype.integer==GT_CTF_ELIMINATION || g_gametype.integer==GT_LMS)	
