diff a/code/cgame/cg_players.c b/code/cgame/cg_players.c	(rejected hunks)
@@ -2592,6 +2592,23 @@ void CG_AddRefEntityWithPowerups(refEntity_t *ent, entityState_t *state, int tea
 		}
 		if (cg_alternateShell.integer > 1)	// NOW add the entity for the glow
 		trap_R_AddRefEntityToScene(ent);
+
+#ifdef NEONARENA_MOD
+		if (cgs.gametype == GT_NEONWAVE && !isMissile && !(state->eFlags & EF_DEAD)
+			&& state->number >= 0 && state->number < MAX_CLIENTS) {
+			clientInfo_t *nci = &cgs.clientinfo[state->number];
+			if (nci->botSkill > 0) {
+				int cl = state->constantLight;
+				qboolean boss = ((cl & 0xFF) > 200) && (((cl >> 8) & 0xFF) < 40);
+				qhandle_t shell = boss ? cgs.media.neonBossShellShader : cgs.media.neonDroneShellShader;
+				if (shell) {
+					ent->customShader = shell;
+					trap_R_AddRefEntityToScene(ent);
+					ent->customShader = 0;
+				}
+			}
+		}
+#endif
 	}
 }
 
